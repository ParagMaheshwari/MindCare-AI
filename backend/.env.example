# MindCare AI Environment Configuration Example

# Server & Network Configuration
PORT=8000
HOST=0.0.0.0
# Allowed frontend origins for CORS (comma-separated, or set to your frontend domain in production)
ALLOWED_ORIGINS=https://your-production-frontend.com
# Public frontend URL used to generate password reset links
FRONTEND_URL=https://your-production-frontend.com

# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration
# Option A: Single unified connection URI (recommended for cloud hosting such as Render/Railway/AWS)
# DATABASE_URL=mysql+pymysql://username:password@host:3306/mindcare_db
# Option B: Individual database parameters
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=mindcare_db

# Security & JWT Authentication
SECRET_KEY=your_64_character_random_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Transactional Email Service (Gmail SMTP for Password Resets)
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Create an App Password for "MindCare AI"
# 4. Copy the 16-character password into SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_digit_google_app_password
MAIL_FROM=MindCare AI <your_gmail_address@gmail.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Administrator Bootstrap Credentials
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_strong_admin_password_here
